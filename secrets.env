# [Gradient] op:// references only; scripts/op-run resolves them for one process.
# Item soev-dev-stack in vault soev-development (dev-only values, section "owui").
# Never put a value in this file or in .env. Rule: soev-docs local-secrets.md.
WEBUI_SECRET_KEY=op://soev-development/soev-dev-stack/owui/WEBUI_SECRET_KEY
WEBUI_ADMIN_PASSWORD=op://soev-development/soev-dev-stack/owui/WEBUI_ADMIN_PASSWORD
DATABASE_PASSWORD=op://soev-development/soev-dev-stack/owui/DATABASE_PASSWORD
MICROSOFT_CLIENT_SECRET=op://soev-development/soev-dev-stack/owui/MICROSOFT_CLIENT_SECRET
OPENAI_API_KEY=op://soev-development/soev-dev-stack/owui/OPENAI_API_KEY
OPENAI_API_KEYS=op://soev-development/soev-dev-stack/owui/OPENAI_API_KEYS
RAG_OPENAI_API_KEY=op://soev-development/soev-dev-stack/owui/RAG_OPENAI_API_KEY
IMAGES_OPENAI_API_KEY=op://soev-development/soev-dev-stack/owui/IMAGES_OPENAI_API_KEY
EXTERNAL_DOCUMENT_LOADER_API_KEY=op://soev-development/soev-dev-stack/owui/EXTERNAL_DOCUMENT_LOADER_API_KEY
CONFLUENCE_BASIC_AUTH_API_TOKEN=op://soev-development/soev-dev-stack/owui/CONFLUENCE_BASIC_AUTH_API_TOKEN
LOADER_INGEST_API_KEY=op://soev-development/soev-dev-stack/owui/LOADER_INGEST_API_KEY
PIPELINE_API_KEY=op://soev-development/soev-dev-stack/owui/PIPELINE_API_KEY
SYNC_API_KEY=op://soev-development/soev-dev-stack/owui/SYNC_API_KEY
SYNC_DAEMON_API_KEY=op://soev-development/soev-dev-stack/owui/SYNC_DAEMON_API_KEY
S3_ACCESS_KEY_ID=op://soev-development/soev-dev-stack/owui/S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=op://soev-development/soev-dev-stack/owui/S3_SECRET_ACCESS_KEY

# Off locally until a dev credential exists: the vault's values for these are the
# staging/production ones, so they are not referenced. Mail invites, Google
# sign-in/Drive and feedback reports to Slack do not work in standalone dev yet.
# EMAIL_GRAPH_CLIENT_SECRET=
# GOOGLE_CLIENT_SECRET=
